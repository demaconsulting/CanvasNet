<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.CanvasNet.MathMl</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>DemaConsulting.CanvasNet.MathMl renders equations written in MathML Core onto a CanvasNet Surface (MathMlDocument.Render): a bounded, deterministic, offline reader with line/column diagnostics, hints and resource limits, the full W3C HTML+MathML set of named character references, and layout over the OpenType MATH table of the bundled Noto Sans Math font, using only managed code. Every MathML Core element is drawn: tokens with automatic italic and every mathvariant, rows and the grouping elements, stretchy and large operators, fractions, radicals, scripts, under- and overscripts, mmultiscripts and tables (mtable, mtr, mtd with spans, and the MathML 3 alignment, spacing and line attributes). MathMlImageSource draws .mml files that other documents link to. Every construct that is recognized but not drawn is reported with a stable identifier, never silently skipped. Not affiliated with the W3C.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/CanvasNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/CanvasNet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>canvas;dotnet-library;mathml;math;equations;opentype-math;fractions;matrices;image-source;rendering</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>CanvasNet.MathMl</Title>
    <Product>DemaConsulting.CanvasNet.MathMl</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>

    <!-- API Documentation Configuration -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References: the core library only (the hardened XML reader, the fonts with their OpenType MATH table,
       and the path filler); no other format package -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.CanvasNet\DemaConsulting.CanvasNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.MathMl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Third-party license notices: the W3C Software and Document License (the named character references of the W3C
       entity file and the operator dictionary (Appendix B.1), the Unicode-based glyph assemblies (Appendix B.4), and
       the italic table (Appendix C.1) of MathML Core) and the Unicode License v3 (the mathvariant tables derived from
       UnicodeData.txt) require their notices in distributions, so they ship as plain files in the package's licenses\
       folder (the same approach as the PlantUml and Mermaid packages), with the provenance record (the license of each
       derived table and the statement that the project is not affiliated with the W3C or Unicode, Inc.) beside them. -->
  <ItemGroup>
    <None Include="third-party\LICENSE-*.txt" Pack="true" PackagePath="licenses\" />
    <None Include="third-party\README.md" Pack="true" PackagePath="licenses\third-party-README.md" />
  </ItemGroup>

  <!-- Returns the files packed into the licenses\ folder with their paths inside the package (PackedPath), so that the
       test project checks what the package ships rather than the repository copies -->
  <Target Name="GetPackedLicenseFiles" Returns="@(_PackedLicenseFile)">
    <ItemGroup>
      <_PackedLicenseFile Include="@(None->'%(FullPath)')" Condition="'%(None.Pack)' == 'true' And $([System.String]::Copy('%(None.PackagePath)').StartsWith('licenses'))" />
      <_PackedLicenseFile>
        <PackedPath>%(PackagePath)</PackedPath>
      </_PackedLicenseFile>
      <_PackedLicenseFile Condition="$([System.String]::Copy('%(PackagePath)').EndsWith('\'))">
        <PackedPath>%(PackagePath)%(Filename)%(Extension)</PackedPath>
      </_PackedLicenseFile>
    </ItemGroup>
  </Target>

</Project>
