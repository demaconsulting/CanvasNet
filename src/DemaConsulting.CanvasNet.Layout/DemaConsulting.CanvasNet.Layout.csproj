<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.CanvasNet.Layout</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>DemaConsulting.CanvasNet.Layout is the shared graph layout of the CanvasNet diagram packages: a port of graphlib and of the dagre layered layout of dagre-d3-es, which positions the nodes of a directed, possibly compound and cyclic graph in ranks and routes its edges, deterministically and within a work budget. It has no public API; it is installed as a dependency of DemaConsulting.CanvasNet.Mermaid and DemaConsulting.CanvasNet.PlantUml. Not affiliated with the dagre, graphlib, dagre-d3-es or lodash projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/CanvasNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/CanvasNet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>canvas;dotnet-library;graph-layout;dagre;graphlib;layered-layout;diagrams</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>CanvasNet.Layout</Title>
    <Product>DemaConsulting.CanvasNet.Layout</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>

    <!-- API Documentation Configuration -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References: none - the layout uses only the .NET base class library (not even the core library) -->

  <!-- Friend assemblies: the layout is an internal implementation dependency of the diagram packages, which are built
       and released in lockstep with it from one commit, so its types stay internal (a faithful port of JavaScript
       semantics is not a public contract) and only the consuming packages and the tests see them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.Layout.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.Mermaid" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.Mermaid.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.PlantUml" />
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.PlantUml.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Third-party license notices: the MIT licenses of dagre-d3-es (with graphlib) and lodash, whose algorithms are
       ported, require the notices to be reproduced in binary distributions, so they ship as plain files in the
       package's licenses\ folder (the same approach as the Mermaid package). -->
  <ItemGroup>
    <None Include="third-party\LICENSE-*.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
