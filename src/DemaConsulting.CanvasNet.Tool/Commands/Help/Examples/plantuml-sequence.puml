@startuml
title Checkout
actor Buyer
participant Shop
participant "Payment provider" as Bank
autonumber
Buyer -> Shop ++ : Place the order
Shop -> Bank : Charge the card
alt Card accepted
  Bank --> Shop : Approved
  Shop --> Buyer : Order confirmed
else Card declined
  Bank --> Shop : Declined
  Shop --> Buyer : Try another card
end
deactivate Shop
note over Buyer, Shop : The receipt is sent by email
@enduml
