<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.CanvasNet.Mermaid</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>DemaConsulting.CanvasNet.Mermaid renders diagrams written in the Mermaid v11 text language onto a CanvasNet Surface (MermaidDocument.Render): a bounded, deterministic, offline reader with file/line/column diagnostics, hints and resource limits. Flowcharts, sequence diagrams, class diagrams, state diagrams, entity relationship diagrams and pie charts are drawn with ports of Mermaid's own layouts. Diagram types and features that are not supported yet are reported with stable identifiers, never silently skipped. Not affiliated with the Mermaid project.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/CanvasNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/CanvasNet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>canvas;dotnet-library;mermaid;diagrams;flowchart;sequence;class-diagram;uml;state-diagram;er-diagram;pie-chart;rendering</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>CanvasNet.Mermaid</Title>
    <Product>DemaConsulting.CanvasNet.Mermaid</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>

    <!-- API Documentation Configuration -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.12" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References: the core library only (no VegaLite, Svg, Charts or any other format package) -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.CanvasNet\DemaConsulting.CanvasNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.CanvasNet.Mermaid.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Third-party license notices: the MIT licenses of the projects whose algorithms and defaults are ported require
       the notices to be reproduced in binary distributions, so they ship as plain files in the package's licenses\
       folder (the same approach as the Liberation fonts' OFL.txt in the core package). -->
  <ItemGroup>
    <None Include="third-party\LICENSE-*.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
