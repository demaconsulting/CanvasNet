package CanvasNet {
    /* cspell:ignore xfrm prst cust bodyPr pPr rPr txBody txStyles lstStyle defRPr normAutofit noAutofit spAutoFit lnSpcReduction fontScale */
    /* cspell:ignore srcRect blipFill tblGrid gridCol tcPr hMerge vMerge gridSpan rowSpan grpSp grpSpPr cxnSp graphicFrame pattFill spTree */
    part def PptxDocument {
        doc /* OOXML (Office Open XML) package parser and presentation-rendering codec, delivered incrementally across Phases 1a-1f, each additive to the last. Phase 1a implements the package layer: opens a .pptx file as a read-only ZipArchive, resolves [Content_Types].xml's default extension mappings and part-specific overrides, and resolves package-level (_rels/.rels) and per-part relationships (including relative-target resolution with ".." traversal). Phase 1b adds the presentation/theme/master/layout/slide model: parses ppt/presentation.xml's declared slide size and ordered slide list, resolves each slide master's theme (color/font scheme), structurally parses each master/layout/slide's placeholder shapes, and implements the verified ECMA-376 placeholder property-inheritance resolver (slide -> layout matched by idx alone, layout -> master matched by type alone via a fixed remapping table). Phase 1c adds DrawingML shape geometry and paint resolution: a shape's <a:xfrm> position/rotation/flip transform, a <p:grpSp> group's chOff/chExt child-coordinate-space transform composition, <a:prstGeom> preset geometry (28 supported names, including a later-hardening-pass-added curved-arrow family) and <a:custGeom> custom path-command parsing resolved into the core Path type, and <a:solidFill>/<a:gradFill>/<a:noFill> fill plus <a:ln> stroke resolution into core paint types - including scheme-color lookup through the resolved theme, the lumMod/lumOff/shade/tint/alpha color-transform pipeline, and a stroked outline realized via the core PathStroker. Phase 1d adds DrawingML text body parsing (<p:txBody>/<a:bodyPr>/<a:p>/<a:pPr>/<a:r>/<a:rPr>/<a:t>), attribute-level run/paragraph property inheritance through the placeholder/layout/master (including the master's own <p:txStyles> titleStyle/bodyStyle/otherStyle buckets)/theme chain, word-wrap/alignment/vertical-anchor/autofit text layout, and glyph-ink rendering onto a core Surface via the core Fonts.TrueTypeFont/SystemFontCatalog and Drawing.PathFiller, mirroring the PDF renderer's own glyph-painting pattern. Phase 1e adds dedicated <p:pic> picture-shape support (content-type dispatch mirroring CanvasNetSvg's SvgCodec.ResolveRasterDecoder, <a:srcRect> crop-rectangle resolution, and y-down nearest-neighbor compositing that deliberately omits the PDF renderer's own y-up vertical flip), <a:tbl> table support (structure/cell parsing reusing the Phase 1c/1d fill/border/text-body resolvers verbatim, merge-aware cell-rect resolution, and cell fill/border/text painting), and recursive, full shape-tree parsing across a slide's own <p:sp>/<p:pic>/<p:graphicFrame>/<p:grpSp> elements (including nested <p:grpSp> child-transform composition) with lazy, invoke-on-demand theme resolution so a shape tree with no <p:graphicFrame> never resolves a theme at all. Phase 1f (this release) adds the public, slide-level rendering API: PptxDocument.Render(int slideIndex, int width, int height, PptxRenderOptions? options) and a DPI convenience overload, which walk a slide's full PptxSlide.ShapeTree recursively in document order with an accumulating transform, dispatching each node kind to the already-verified Phase 1c/1d/1e resolvers/painters verbatim - composing a group's own already-resolved child transform, resolving an ordinary/placeholder shape's geometry/fill/stroke/text (a placeholder's own text is always read from the slide-level shape's own txBody, never from its matched layout placeholder), compositing a picture's embedded image, and painting a graphic frame's own table - clearing the destination Surface to PptxRenderOptions.BackgroundColor (default opaque white) before painting, and silently skipping a shape/picture/graphic-frame with no resolvable xfrm or a picture with no blipFill, mirroring ParseShapeTree's own tolerant-tree-walk precedent. With Phase 1f, the planned PPTX 1.0 feature set is complete. A slide's own <p:bg> background fill (no parsing support exists anywhere in this codebase), a non-placeholder shape's own background fill via <a:blipFill>/<a:pattFill> inside <p:spPr> (picture/pattern fill remains scoped to a dedicated <p:pic> shape's own <p:blipFill>), picture effects/shadows, nested tables, table auto-sizing to fit overflowing cell content (each row's resolved height is taken verbatim from its declared <a:tr h="..."> value, with no growth to accommodate overflowing cell content), table style/banding (<a:tableStyleId>), <p:cxnSp> connector shapes, master/layout full shape-tree enumeration/rendering, group-level style cascading beyond transform composition, radial/path gradients, <a:avLst> adjustment-value parsing, bullets/numbering, full text justification, <a:spAutoFit> shape-resize autofit, kerning, and text clipping on overflow remain out of scope; none of these is a currently planned phase, and any of them remaining important is a candidate for a future, corpus-driven hardening pass (pptx-phase-2), not a scheduled increment. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet.Pptx/PptxDocument.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Package.cs, src/DemaConsulting.CanvasNet.Pptx/NamespaceDoc.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Presentation.cs, src/DemaConsulting.CanvasNet.Pptx/PptxSlideSize.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Theme.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTheme.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Masters.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Layouts.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Slides.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPlaceholder.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Inheritance.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPlaceholderProperties.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Geometry.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Paint.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPresetGeometry.cs, src/DemaConsulting.CanvasNet.Pptx/PptxShapeFrame.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPaint.cs, src/DemaConsulting.CanvasNet.Pptx/PptxLineStyle.cs, src/DemaConsulting.CanvasNet.Pptx/PptxUnsupportedFeatureException.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTextBody.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Text.cs, src/DemaConsulting.CanvasNet.Pptx/PptxEffectiveTextProperties.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextInheritance.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTextLayout.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextLayout.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextRender.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPicture.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Images.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTable.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Tables.cs, src/DemaConsulting.CanvasNet.Pptx/PptxShapeTree.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.ShapeTree.cs, src/DemaConsulting.CanvasNet.Pptx/PptxRenderOptions.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Render.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Pptx.Tests/PptxDocumentTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxSystemIntegrationTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxGeometryTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxPaintTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextLayoutTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextRenderTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxImagesTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTablesTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxGroupsTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxRenderTests.cs */
        comment designRef /* Design: docs/design/canvas-net-pptx/pptx-document.md */
        comment verificationRef /* Verification: docs/verification/canvas-net-pptx/pptx-document.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net-pptx/pptx-document.yaml */
    }
}
