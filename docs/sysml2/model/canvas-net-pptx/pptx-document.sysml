package CanvasNet {
    /* cspell:ignore xfrm prst cust bodyPr pPr rPr txBody txStyles lstStyle defRPr normAutofit noAutofit spAutoFit lnSpcReduction fontScale */
    part def PptxDocument {
        doc /* OOXML (Office Open XML) package parser and, in later phases, presentation-rendering codec. Phase 1a implements the package layer: opens a .pptx file as a read-only ZipArchive, resolves [Content_Types].xml's default extension mappings and part-specific overrides, and resolves package-level (_rels/.rels) and per-part relationships (including relative-target resolution with ".." traversal). Phase 1b adds the presentation/theme/master/layout/slide model: parses ppt/presentation.xml's declared slide size and ordered slide list, resolves each slide master's theme (color/font scheme), structurally parses each master/layout/slide's placeholder shapes, and implements the verified ECMA-376 placeholder property-inheritance resolver (slide -> layout matched by idx alone, layout -> master matched by type alone via a fixed remapping table). Phase 1c adds DrawingML shape geometry and paint resolution: a shape's <a:xfrm> position/rotation/flip transform, a <p:grpSp> group's chOff/chExt child-coordinate-space transform composition, <a:prstGeom> preset geometry (24 supported names) and <a:custGeom> custom path-command parsing resolved into the core Path type, and <a:solidFill>/<a:gradFill>/<a:noFill> fill plus <a:ln> stroke resolution into core paint types - including scheme-color lookup through the resolved theme, the lumMod/lumOff/shade/tint/alpha color-transform pipeline, and a stroked outline realized via the core PathStroker. Phase 1d (this release) adds DrawingML text body parsing (<p:txBody>/<a:bodyPr>/<a:p>/<a:pPr>/<a:r>/<a:rPr>/<a:t>), attribute-level run/paragraph property inheritance through the placeholder/layout/master (including the master's own <p:txStyles> titleStyle/bodyStyle/otherStyle buckets)/theme chain, word-wrap/alignment/vertical-anchor/autofit text layout, and glyph-ink rendering onto a core Surface via the core Fonts.TrueTypeFont/SystemFontCatalog and Drawing.PathFiller, mirroring the PDF renderer's own glyph-painting pattern. Pattern/picture fill, radial/path gradients, <a:avLst> adjustment-value parsing, full group-shape rendering semantics beyond transform composition, bullets/numbering, full text justification, <a:spAutoFit> shape-resize autofit, kerning, text clipping on overflow, and a full per-slide public Render API are explicitly deferred. No non-placeholder (freeform) shape enumeration from a slide's full <p:spTree> is implemented yet. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet.Pptx/PptxDocument.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Package.cs, src/DemaConsulting.CanvasNet.Pptx/NamespaceDoc.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Presentation.cs, src/DemaConsulting.CanvasNet.Pptx/PptxSlideSize.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Theme.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTheme.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Masters.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Layouts.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Slides.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPlaceholder.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Inheritance.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPlaceholderProperties.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Geometry.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Paint.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPresetGeometry.cs, src/DemaConsulting.CanvasNet.Pptx/PptxShapeFrame.cs, src/DemaConsulting.CanvasNet.Pptx/PptxPaint.cs, src/DemaConsulting.CanvasNet.Pptx/PptxLineStyle.cs, src/DemaConsulting.CanvasNet.Pptx/PptxUnsupportedFeatureException.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTextBody.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.Text.cs, src/DemaConsulting.CanvasNet.Pptx/PptxEffectiveTextProperties.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextInheritance.cs, src/DemaConsulting.CanvasNet.Pptx/PptxTextLayout.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextLayout.cs, src/DemaConsulting.CanvasNet.Pptx/PptxDocument.TextRender.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Pptx.Tests/PptxDocumentTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxSystemIntegrationTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxGeometryTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxPaintTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextLayoutTests.cs, test/DemaConsulting.CanvasNet.Pptx.Tests/PptxTextRenderTests.cs */
        comment designRef /* Design: docs/design/canvas-net-pptx/pptx-document.md */
        comment verificationRef /* Verification: docs/verification/canvas-net-pptx/pptx-document.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net-pptx/pptx-document.yaml */
    }
}
