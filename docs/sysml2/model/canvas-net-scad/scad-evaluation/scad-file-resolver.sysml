package CanvasNet {
    part def ScadFileResolver {
        doc /* The internal ScadFileResolver (a sealed partial class) and the immutable ScadSourceUnit it produces: before any evaluation it expands include directives textually (keeping each statement's own source location) and loads use directives as separate, private library units, reading every file through the core SandboxedFileResolver, which enforces the sandbox - the base directory and library paths in file-system mode, or normalized logical paths handed to the caller's resolver callback with no file-system access at all - rejecting absolute paths, drive letters, control characters (C0 and C1), paths that escape their root, and any symbolic link or junction below a root (whatever its target, a dangling link included), treating a directory in place of a file, an unopenable file and a throwing callback as read failures, and never consulting environment variables. This unit adds the search context (the including file's directory, then the library paths), include cycles, bounds on include depth, included files, and expanded statements, the bounded UTF-8 decoding with byte-order-mark detection and the source-length limit, one parse per distinct file, the file names used in locations, and the OpenSCAD wording and location of every sandbox refusal; it reports a missing file as a warning, lets syntax errors in referenced files surface with that file's name, and polls cancellation between files. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet.Scad/Evaluation/ScadSourceUnit.cs, src/DemaConsulting.CanvasNet.Scad/Evaluation/ScadFileResolver.cs, src/DemaConsulting.CanvasNet.Scad/Evaluation/ScadFileResolver.Paths.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverIncludeTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverUseTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverSandboxTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverLinkTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverLimitTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadFileResolverFileSystemTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Evaluation/ScadResolverTestSupport.cs */
        comment designRef /* Design: docs/design/canvas-net-scad/scad-evaluation/scad-file-resolver.md */
        comment verificationRef /* Verification: docs/verification/canvas-net-scad/scad-evaluation/scad-file-resolver.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net-scad/scad-evaluation/scad-file-resolver.yaml */
    }
}
