        comment testRef /* Test: test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderWalkTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderStackTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderCancellationTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderLimitTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderBooleanTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderHullTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderMinkowskiTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryBuilderTransformDepthTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadSceneOptionsTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadUnsupportedModuleTests.cs, test/DemaConsulting.CanvasNet.Scad.Tests/Geometry/ScadGeometryTestSupport.cs */
