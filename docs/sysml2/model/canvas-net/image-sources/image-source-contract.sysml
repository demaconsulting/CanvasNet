package CanvasNet {
    /* cspell:ignore embedder */
    part def ImageSourceContract {
        doc /* The public contract of the ImageSources subsystem: IImageSource (a format or live source: a name, the lower-case file name extensions it claims, the lower-case URI schemes it claims, and Render), ImageSourceRequest (the raw link; for a file-based request the bytes, relative name, and folder of the file, for a scheme-claimed request nothing but the link; the requested size, the live shared pixel budget (Budget, an ImageBudget; RemainingPixels reads it live; EnsureWithinBudget charges each surface a source is about to allocate and records it in ChargedPixels), the scoped IImageResolver, the strictness switch, a cancellation token; OpenContent and the SizeFor sizing rule), ImageBudget (the live pixel counter a render shares), ImageSourceResult (the picture, notes, printed text, and format; the lists are copied into read-only snapshots), ImageSourceDiagnostic and ImageDiagnosticSeverity, IImageResolver (what a renderer calls), EmbeddedImage (a loaded image with link, format, size, and depth), ImageSourceException (link, embedder, and the original failure), ImageSourceBudgetException (the refusal of a source for a picture over the pixel budget), and ImageSourceSet (an ordered, immutable list that validates claims, lets the later source win, and finds the source of a file name by its longest suffix or of a scheme). Anyone can implement it outside this repository. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet/ImageSources/IImageSource.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceRequest.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageBudget.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceResult.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceDiagnostic.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageDiagnosticSeverity.cs, src/DemaConsulting.CanvasNet/ImageSources/IImageResolver.cs, src/DemaConsulting.CanvasNet/ImageSources/EmbeddedImage.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceException.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceBudgetException.cs, src/DemaConsulting.CanvasNet/ImageSources/ImageSourceSet.cs, src/DemaConsulting.CanvasNet/ImageSources/NamespaceDoc.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Tests/ImageSources/ImageSourceSetTests.cs, test/DemaConsulting.CanvasNet.Tests/ImageSources/ImageSourceContractTests.cs, test/DemaConsulting.CanvasNet.Tests/ImageSources/ImageSourceTestSupport.cs */
        comment designRef /* Design: docs/design/canvas-net/image-sources/image-source-contract.md */
        comment verificationRef /* Verification: docs/verification/canvas-net/image-sources/image-source-contract.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net/image-sources/image-source-contract.yaml */
    }
}
