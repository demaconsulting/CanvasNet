package CanvasNet {
    part def SourceLoader {
        doc /* Turns a path into facts or into pixels for the files the tool reads. Detect recognizes the format from the signature bytes, then the entries of a ZIP package (presentation or drawing), then SVG text, then the extension; Probe reads the header facts (format, size, channels, transparency, decodability, frame count, EXIF orientation, and for a PDF, PPTX, or VSDX document every page with its size, rotation, and name) without decoding; Load and OpenPages decode a raster at its own size, render an SVG directly at the target size, or render a chosen page of a document at a resolution (opening the document once for all its pages), applying the size policy (scale, width, height, fitting a page inside a box, rounding, the 8192-pixel limit before decoding), the EXIF orientation of a JPEG, and the background color, collecting the notes about skipped or approximated features (or refusing them when strict), and reporting the operations applied. It maps an explicit list of library exceptions (missing, unreadable, unsupported feature, corrupt data) to expected errors and lets every other exception propagate. The unit includes ExifOrientation (reading the orientation from a JPEG and applying it to pixels), SurfaceOperations (flatten and transparency test), and the supporting model types SourceKind, OutputFormat, SourceInfo, SourceOptions, LoadedSource, AppliedOperation, ImageDiagnostic, and SourcePage. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Detect.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Raster.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Svg.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Documents.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Pdf.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Pptx.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceLoader.Vsdx.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/ExifOrientation.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SurfaceOperations.cs, src/DemaConsulting.CanvasNet.Tool/Imaging/SourceModels.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Tool.Tests/Imaging/SourceLoaderTests.cs, test/DemaConsulting.CanvasNet.Tool.Tests/Imaging/SourceLoaderVectorTests.cs, test/DemaConsulting.CanvasNet.Tool.Tests/Imaging/ExifOrientationTests.cs */
        comment designRef /* Design: docs/design/canvas-net-tool/imaging/source-loader.md */
        comment verificationRef /* Verification: docs/verification/canvas-net-tool/imaging/source-loader.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net-tool/imaging/source-loader.yaml */
    }
}
