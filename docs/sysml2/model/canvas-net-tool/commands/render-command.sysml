package CanvasNet {
    part def RenderCommand {
        doc /* The render command and its alias convert, and the verb commands crop, resize, rotate, flip, and pad that are the same unit constructed with a verb: loads an image, drawing, document page, or OpenSCAD model view, applies the image pipeline, and writes it as PNG, JPEG, BMP, or TIFF in one pass for one page or every page. It declares its options (page, all-pages, dpi, scale, width, height, size, background, no-auto-orient, strict, the model options view, azimuth, elevation, projection, define (-D), time, default-color, and max-triangles, the pipeline options crop, resize, fit, allow-upscale, rotate, flip, pad, pad-color, and filter, output, format, quality, no-clobber) in one table, shared by the verbs, that also drives the help, reads and validates them (rejecting contradictory size options, malformed values, a view or projection that does not exist, a page together with all pages, a model option for an input that is not a model, an angle that is not a right angle, and sizes beyond the maximum), reports every mistake about the input, the pages, and every output before decoding anything, plans the output file of each page ({page} placeholder or a directory), loads the source once through the SourceLoader, applies the ImagePipeline operations in the order written (a verb's operand is the first operation), writes each page through the ImageWriter (every page is staged first and all are published together only when every page succeeded, so a failing page leaves no new or partial output), and reports the result as one text line per output or, when the JSON option is given, as one JSON document with the tool, the input (with the page and page count of a document), the operations applied in order (the loader's, the pipeline's with their parameters and sizes, and the flatten of a JPEG), the outputs, the diagnostics with their pages, and the echoed text. */

        comment sourceRef /* Source: src/DemaConsulting.CanvasNet.Tool/Commands/RenderCommand.cs, src/DemaConsulting.CanvasNet.Tool/Commands/RenderCommand.Options.cs, src/DemaConsulting.CanvasNet.Tool/Commands/RenderCommand.Verbs.cs */
        comment testRef /* Test: test/DemaConsulting.CanvasNet.Tool.Tests/Commands/RenderCommandTests.cs, test/DemaConsulting.CanvasNet.Tool.Tests/Commands/RenderCommandDocumentTests.cs, test/DemaConsulting.CanvasNet.Tool.Tests/Commands/RenderCommandScadTests.cs, test/DemaConsulting.CanvasNet.Tool.Tests/Commands/RenderCommandPipelineTests.cs */
        comment designRef /* Design: docs/design/canvas-net-tool/commands/render-command.md */
        comment verificationRef /* Verification: docs/verification/canvas-net-tool/commands/render-command.md */
        comment reqRef /* Requirements: docs/reqstream/canvas-net-tool/commands/render-command.yaml */
    }
}
