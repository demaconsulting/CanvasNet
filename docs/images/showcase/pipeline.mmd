%% beside this file. composition.svg embeds this diagram. Every picture node has its w and h.
flowchart LR
    req[/Requirements/] --> part
    part@{ img: "hull.scad", label: "Enclosure (OpenSCAD)", pos: "b", w: 150, h: 130, constraint: "off" }
