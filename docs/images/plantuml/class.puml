@startuml
skinparam ranksep 50
abstract class Item {
  +title : String
  {abstract} +loanDays() : int
}
class Member {
  +name : String
  -fines : decimal
}
class Loan {
  +due : Date
  +renew()
}
class Book {
  +isbn : String
}
class Film {
  +minutes : int
}
enum LoanState {
  OPEN
  RETURNED
  OVERDUE
}
Member "1" *-- "0..*" Loan
Item "1" <-- "0..*" Loan
Item <|-- Book
Item <|-- Film
Loan -right-> LoanState
@enduml
