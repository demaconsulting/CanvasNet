<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"
      alttext="x plus y to the n equals the sum over k from 0 to n of n choose k, x to the n minus k, y to the k">
  <msup>
    <mrow>
      <mo stretchy="false">(</mo>
      <mi>x</mi>
      <mo>+</mo>
      <mi>y</mi>
      <mo stretchy="false">)</mo>
    </mrow>
    <mi>n</mi>
  </msup>
  <mo>=</mo>
  <munderover>
    <mo>&sum;</mo>
    <mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow>
    <mi>n</mi>
  </munderover>
  <mrow>
    <mo>(</mo>
    <mfrac linethickness="0">
      <mi>n</mi>
      <mi>k</mi>
    </mfrac>
    <mo>)</mo>
  </mrow>
  <msup>
    <mi>x</mi>
    <mrow><mi>n</mi><mo>&minus;</mo><mi>k</mi></mrow>
  </msup>
  <mo>&InvisibleTimes;</mo>
  <msup><mi>y</mi><mi>k</mi></msup>
</math>