{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatter plot with a polynomial regression and a loess smoother, both computed by transforms.",
  "title": "Plant height by weeks of light",
  "width": 320,
  "height": 200,
  "data": {"sequence": {"start": 0, "stop": 70, "as": "i"}},
  "transform": [
    {"calculate": "datum.i * 0.2 + 0.3 * sin(datum.i * 9.1)", "as": "weeks"},
    {"calculate": "6 + datum.weeks * 2.2 - datum.weeks * datum.weeks * 0.08 + 2.2 * sin(datum.i * 3.7)", "as": "height"}
  ],
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "color": "#9aa5b1", "size": 28},
      "encoding": {
        "x": {"field": "weeks", "type": "quantitative", "title": "Weeks of light"},
        "y": {"field": "height", "type": "quantitative", "title": "Height (cm)"}
      }
    },
    {
      "transform": [{"regression": "height", "on": "weeks", "method": "poly", "order": 2}],
      "mark": {"type": "line", "color": "#c0392b", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "weeks", "type": "quantitative"},
        "y": {"field": "height", "type": "quantitative"}
      }
    },
    {
      "transform": [{"loess": "height", "on": "weeks", "bandwidth": 0.2}],
      "mark": {"type": "line", "color": "#1f77b4", "strokeWidth": 2, "strokeDash": [6, 3]},
      "encoding": {
        "x": {"field": "weeks", "type": "quantitative"},
        "y": {"field": "height", "type": "quantitative"}
      }
    }
  ]
}
