<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"
      alttext="The Fourier series of f: a 0 over 2 plus the sum over n from 1 to infinity of a n cos n pi x over L plus b n sin n pi x over L">
  <mi>f</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mfrac><msub><mi>a</mi><mn>0</mn></msub><mn>2</mn></mfrac>
  <mo>+</mo>
  <munderover>
    <mo>&sum;</mo>
    <mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow>
    <mi>&infin;</mi>
  </munderover>
  <mrow>
    <mo>(</mo>
    <msub><mi>a</mi><mi>n</mi></msub>
    <mo>&InvisibleTimes;</mo>
    <mi>cos</mi>
    <mo>&ApplyFunction;</mo>
    <mspace width="0.1667em"/>
    <mfrac>
      <mrow><mi>n</mi><mo>&InvisibleTimes;</mo><mi>&pi;</mi><mo>&InvisibleTimes;</mo><mi>x</mi></mrow>
      <mi>L</mi>
    </mfrac>
    <mo>+</mo>
    <msub><mi>b</mi><mi>n</mi></msub>
    <mo>&InvisibleTimes;</mo>
    <mi>sin</mi>
    <mo>&ApplyFunction;</mo>
    <mspace width="0.1667em"/>
    <mfrac>
      <mrow><mi>n</mi><mo>&InvisibleTimes;</mo><mi>&pi;</mi><mo>&InvisibleTimes;</mo><mi>x</mi></mrow>
      <mi>L</mi>
    </mfrac>
    <mo>)</mo>
  </mrow>
</math>