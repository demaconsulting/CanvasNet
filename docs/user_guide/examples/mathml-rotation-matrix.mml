<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"
      alttext="The rotation by theta: x prime, y prime equals the matrix cos theta, minus sin theta, sin theta, cos theta, times x, y">
  <mrow>
    <mo>(</mo>
    <mtable>
      <mtr><mtd><mi>x</mi><mo>&prime;</mo></mtd></mtr>
      <mtr><mtd><mi>y</mi><mo>&prime;</mo></mtd></mtr>
    </mtable>
    <mo>)</mo>
  </mrow>
  <mo>=</mo>
  <mrow>
    <mo>(</mo>
    <mtable>
      <mtr>
        <mtd><mi>cos</mi><mo>&ApplyFunction;</mo><mspace width="0.1667em"/><mi>&theta;</mi></mtd>
        <mtd><mrow><mo>&minus;</mo><mi>sin</mi><mo>&ApplyFunction;</mo><mspace width="0.1667em"/><mi>&theta;</mi></mrow></mtd>
      </mtr>
      <mtr>
        <mtd><mi>sin</mi><mo>&ApplyFunction;</mo><mspace width="0.1667em"/><mi>&theta;</mi></mtd>
        <mtd><mi>cos</mi><mo>&ApplyFunction;</mo><mspace width="0.1667em"/><mi>&theta;</mi></mtd>
      </mtr>
    </mtable>
    <mo>)</mo>
  </mrow>
  <mrow>
    <mo>(</mo>
    <mtable>
      <mtr><mtd><mi>x</mi></mtd></mtr>
      <mtr><mtd><mi>y</mi></mtd></mtr>
    </mtable>
    <mo>)</mo>
  </mrow>
</math>