<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"
      alttext="Carbon 14 decays to nitrogen 14, an electron, and an electron antineutrino">
  <mmultiscripts>
    <mi mathvariant="normal">C</mi>
    <mprescripts/>
    <mn>6</mn>
    <mn>14</mn>
  </mmultiscripts>
  <mo>&rarr;</mo>
  <mmultiscripts>
    <mi mathvariant="normal">N</mi>
    <mprescripts/>
    <mn>7</mn>
    <mn>14</mn>
  </mmultiscripts>
  <mo>+</mo>
  <msup><mi mathvariant="normal">e</mi><mo>&minus;</mo></msup>
  <mo>+</mo>
  <msub>
    <mover accent="true"><mi>&nu;</mi><mo>&#xAF;</mo></mover>
    <mi mathvariant="normal">e</mi>
  </msub>
</math>