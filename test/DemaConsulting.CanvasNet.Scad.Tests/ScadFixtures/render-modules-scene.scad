// Original CanvasNet test fixture: a scene generated by modules, recursion, loops and children.

// A staircase built by recursion: n steps of width w, each rise higher than the next, along +X
module steps(n, w = 10, rise = 2) {
  if (n > 0) {
    cube([w, 10, rise * n]);
    translate([w, 0, 0]) steps(n - 1, w, rise);
  }
}

// Places a copy of its child on a circle of the given radius, count times
module around(count, radius) {
  for (i = [0 : count - 1])
    rotate([0, 0, i * 360 / count]) translate([radius, 0, 0]) children();
}

// A module that paints whatever it is given
module painted(name) {
  color(name) children();
}

// Six steps covering x 0..60, y 0..10 with heights 12, 10, 8, 6, 4, 2
painted("gray") steps(6);

// Eight posts of radius 2 and height 8 on a circle of radius 10 around (-30, 30)
translate([-30, 30, 0]) painted("sienna") around(8, 10) cylinder(r = 2, h = 8, $fn = 24);
