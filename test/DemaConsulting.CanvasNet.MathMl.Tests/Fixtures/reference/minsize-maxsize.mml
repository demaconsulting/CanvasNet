<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mo minsize="3em">(</mo>
    <mi>x</mi>
    <mo minsize="250%">)</mo>
  </mrow>
  <mrow>
    <mo maxsize="1.2em">(</mo>
    <mspace width="10px" height="2em" depth="1em"/>
    <mo maxsize="150%">)</mo>
  </mrow>
  <mrow>
    <mo>(</mo>
    <mo>)</mo>
  </mrow>
  <mrow>
    <mrow>
      <mo>[</mo>
    </mrow>
    <mspace width="10px" height="2em" depth="1em"/>
    <mstyle mathcolor="red">
      <mo>]</mo>
    </mstyle>
  </mrow>
</math>
