<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mo>(</mo>
    <mfrac>
      <mi>a</mi>
      <mi>b</mi>
    </mfrac>
    <mo>)</mo>
  </mrow>
  <mrow>
    <mo>[</mo>
    <mstyle displaystyle="true">
      <mfrac>
        <mi>x</mi>
        <mrow>
          <mn>2</mn>
          <mi>z</mi>
        </mrow>
      </mfrac>
    </mstyle>
    <mo>]</mo>
  </mrow>
</math>
