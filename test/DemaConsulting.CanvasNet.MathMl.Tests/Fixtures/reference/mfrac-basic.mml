<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mfrac>
    <mi>a</mi>
    <mi>b</mi>
  </mfrac>
  <mo>+</mo>
  <mfrac>
    <mrow>
      <mi>x</mi>
