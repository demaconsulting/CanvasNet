{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 200,
  "height": 100,
  "data": {
    "values": [
      { "day": 1, "height": 1, "moisture": 3 },
      { "day": 2, "height": 3, "moisture": 12 },
      { "day": 3, "height": 2, "moisture": 27 },
      { "day": 4, "height": 4, "moisture": 41 },
      { "day": 5, "height": 2, "moisture": 58 },
      { "day": 6, "height": 5, "moisture": 66 },
      { "day": 7, "height": 1, "moisture": 83 },
      { "day": 8, "height": 3, "moisture": 97 }
    ]
  },
  "mark": "circle",
  "encoding": {
    "x": { "field": "day", "type": "quantitative" },
    "y": { "field": "height", "type": "quantitative" },
    "color": {
      "condition": { "test": "datum.moisture < 30", "value": "#d73027" },
      "value": "#4575b4"
    },
    "size": {
      "condition": { "test": { "field": "height", "gte": 4 }, "value": 240 },
      "value": 60
    },
    "opacity": {
      "condition": { "test": { "field": "day", "range": [3, 5] }, "value": 1 },
      "value": 0.4
    }
  }
}
