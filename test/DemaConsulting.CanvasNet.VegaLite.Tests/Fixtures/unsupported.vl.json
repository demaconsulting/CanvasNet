{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Uses a geoshape mark, a lookup in a parameter and a band position, which are recognized but not drawn.",
  "data": {
    "values": [
      { "week": 1, "visits": 120 },
      { "week": 2, "visits": 150 },
      { "week": 3, "visits": 90 }
    ]
  },
  "transform": [
    { "lookup": "week", "from": { "param": "p" } }
  ],
  "mark": "geoshape",
  "encoding": {
    "x": { "field": "week", "type": "ordinal" },
    "y": { "field": "visits", "type": "quantitative", "bandPosition": 0.5 }
  }
}
