{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Uses a line mark, a window transform and an aggregate, which are recognized but not drawn yet.",
  "data": {
    "values": [
      { "week": 1, "visits": 120 },
      { "week": 2, "visits": 150 },
      { "week": 3, "visits": 90 }
    ]
  },
  "transform": [
    { "window": [ { "op": "rank", "as": "place" } ], "sort": [ { "field": "visits" } ] }
  ],
  "mark": "line",
  "encoding": {
    "x": { "field": "week", "type": "ordinal" },
    "y": { "field": "visits", "type": "quantitative", "aggregate": "sum" }
  }
}
